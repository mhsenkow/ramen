[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
macos.debug = "res://bin/librama_sim.dylib"
macos.release = "res://bin/librama_sim.dylib"
linux.debug.x86_64 = "res://bin/librama_sim.so"
linux.release.x86_64 = "res://bin/librama_sim.so"
windows.debug.x86_64 = "res://bin/rama_sim.dll"
windows.release.x86_64 = "res://bin/rama_sim.dll"
